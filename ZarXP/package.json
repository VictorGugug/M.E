{
  "name": "zarxp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build && node scripts/postbuild-pages.mjs",
    "lint": "oxlint --ignore-pattern public",
    "test": "node --experimental-strip-types --test",
    "test:e2e": "playwright test",
    "test:e2e:tier1": "playwright test e2e/tier1-features --pass-with-no-tests",
    "test:e2e:tier2": "playwright test e2e/tier2-boundary --pass-with-no-tests",
    "test:e2e:tier3": "playwright test e2e/tier3-pairwise --pass-with-no-tests",
    "test:e2e:tier4": "playwright test e2e/tier4-scenarios --pass-with-no-tests",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
